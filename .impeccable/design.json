  "narrative": {
    "northStar": "Quiet Atlas",
    "overview": "Quiet Atlas makes database structure comfortable to read. The canvas is near-white paper with a fine dotted field; tables are white, clearly separated surfaces. Purple carries actions and selection while restrained neutral wires preserve the surrounding structure.\n\nArabic controls share the workspace with English database identifiers. Keep ER Atlas's supplied connected-node mark, purple identity and local font assets. The chosen direction favors readable rows, two grouped navigation levels and small bottom tools. Actual schema data supplies the content and topology.",
    "keyCharacteristics": [
      "Readable table surfaces on a light dotted canvas.",
      "Arabic interface type paired with monospaced fields and SQL.",
      "Purple actions and lavender state surfaces.",
      "Thin separators, modest corners and restrained overlay depth.",
      "Compact navigation around a pannable data canvas."
    ],
    "rules": [
      {
        "name": "The Context Stays Visible Rule",
        "body": "Keep unrelated nodes readable and unrelated wires present when a table or relationship receives emphasis.",
        "section": "colors"
      },
      {
        "name": "The Two Reading Voices Rule",
        "body": "Use proportional interface type for navigation and schema-node titles; reserve monospace for field-level structure, code and numerical readouts.",
        "section": "typography"
      },
      {
        "name": "The Flat Tables Rule",
        "body": "Table cards use separators and state outlines for hierarchy; reserve ambient elevation for tools and overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the connected-node mark, purple identity and local Noto Sans Arabic / Roboto Mono fonts.",
      "**Do** keep table geometry and relationship endpoints synchronized between styles and shared measurements.",
      "**Do** prioritize real keys in compact previews and retain every column in the complete table view.",
      "**Do** keep the context visible around selection and reserve bottom space for canvas tools.",
      "**Do** bound narrow-screen overlays, preserve accessible action names and allow canvas panning."
    ],
    "donts": [
      "**Don't** invent schema relationships or cardinality to reproduce an illustration.",
      "**Don't** shrink table rows or default the entry camera to unreadable whole-diagram scale.",
      "**Don't** reset saved coordinates to imitate the approved composition.",
      "**Don't** add decorative gradients or ambient shadows to resting table cards.",
      "**Don't** replace supplied vector assets with decorative text glyphs."
    ]
  }
}
